# ARIP demo environment defaults.
#
# Copy to .env (gitignored) and override per-host as needed.
# Everything below has a working default baked into docker-compose.yml
# and the Go services — you typically only need to touch this file
# if you're moving ports around or pointing at an external Postgres.

# ─── OpenTelemetry pipeline ──────────────────────────────────────────
# Services emit to the OTel Collector, which applies tail-based
# sampling before forwarding to Jaeger. See
# demo-env/otel-collector/config.yaml for the policy.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ─── Service ports (host side) ───────────────────────────────────────
# These are informational — the docker-compose.yml does NOT consume
# them via interpolation. If you change a port, edit docker-compose.yml.
PAYMENT_PORT=8080
INVENTORY_PORT=8081
JAEGER_UI_PORT=16686
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318

# ─── inventory-service ───────────────────────────────────────────────
# Deliberately small so a handful of concurrent requests can saturate
# it in the pool_exhaustion demo scenario.
POOL_MAX_CONNS=3

# ─── Postgres ────────────────────────────────────────────────────────
POSTGRES_USER=arip
POSTGRES_PASSWORD=arip
POSTGRES_DB=arip

# ─── Optional: LLM TL;DR ─────────────────────────────────────────────
# When set, the reporter uses Claude to paraphrase the deterministic
# findings into a 2-4 sentence TL;DR. With no key the report is fully
# deterministic. The LLM never sees raw telemetry, only the rule
# output, so it cannot introduce new claims.
# ANTHROPIC_API_KEY=sk-ant-...
